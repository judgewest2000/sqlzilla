<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sqlzilla.Views.QueryTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sqlzilla.Views">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Padding="10,8,10,8" ColumnSpacing="8" BorderThickness="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ExecuteButton" Style="{StaticResource AccentButtonStyle}" Click="Execute_Click"
                    ToolTipService.ToolTip="Execute the selection, or the whole script (F5 / Ctrl+Enter)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                    <TextBlock Text="Execute" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Grid.Column="1" IsEnabled="False" Click="Cancel_Click" ToolTipService.ToolTip="Cancel executing query (Alt+Break)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="13" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
            <ComboBox x:Name="DatabaseBox" Grid.Column="2" MinWidth="200" MaxWidth="320" PlaceholderText="Database"
                      SelectionChanged="DatabaseBox_SelectionChanged" ToolTipService.ToolTip="Current database" />
            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="Open_Click" ToolTipService.ToolTip="Open .sql file (Ctrl+O)">
                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="Save_Click" ToolTipService.ToolTip="Save .sql file (Ctrl+S)">
                <FontIcon Glyph="&#xE74E;" FontSize="14" />
            </Button>
            <Button Grid.Column="5" HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Click="RefreshIntellisense_Click"
                    ToolTipService.ToolTip="Refresh IntelliSense: reload tables, columns and routines (Shift+Alt+R)">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Border x:Name="ReadOnlyBadge" Grid.Column="6" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed"
                    ToolTipService.ToolTip="This group is read-only: connections use ApplicationIntent=ReadOnly and statements that modify data need confirmation">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="ReadOnlyIcon" Glyph="&#xE72E;" FontSize="12" />
                    <TextBlock x:Name="ReadOnlyText" Text="READ-ONLY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" Padding="10,0,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="EditorArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="DocsColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <views:CodeEditor x:Name="Editor" Placeholder="-- Write T-SQL here. F5 or Ctrl+Enter runs the selection or the whole script. F1 shows schema docs." />
                <views:PaneSplitter x:Name="DocsSplitter" Grid.Column="1" Target="2" Visibility="Collapsed" ToolTipService.ToolTip="Drag to resize · double-click to reset" />
                <views:SchemaDocsPanel x:Name="DocsPanel" Grid.Column="2" Visibility="Collapsed" CloseRequested="DocsPanel_CloseRequested" />
            </Grid>
            <views:PaneSplitter x:Name="Splitter" Grid.Row="1" IsHorizontal="True" Target="0" ToolTipService.ToolTip="Drag to resize · double-click to reset" />
            <Grid x:Name="ResultsPane" Grid.Row="2" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
                    <SelectorBarItem x:Name="ResultsTabItem" Text="Results"                     Icon="ViewAll" IsSelected="True" />
                                        <SelectorBarItem x:Name="MessagesTabItem" Text="Messages" Icon="Message" />
                </SelectorBar>
                                    <Grid x:Name="ResultsHost" Grid.Row="1" />
                <Border x:Name="MessagesHost" Grid.Row="1" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <ScrollViewer x:Name="MessagesScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" Padding="10,8">
                        <RichTextBlock x:Name="MessagesText" IsTextSelectionEnabled="True" FontFamily="{StaticResource CodeFont}" FontSize="13" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar in the group colour -->
        <Grid x:Name="StatusBar" Grid.Row="2" Height="26" Padding="10,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                <FontIcon x:Name="StateIcon" Glyph="&#xE73E;" FontSize="12" />
                <TextBlock x:Name="StateText" Text="Connecting…" FontSize="12" />
            </StackPanel>
            <TextBlock x:Name="SchemaNote" Grid.Column="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="GroupText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="ServerText" Grid.Column="3" FontSize="12" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="LoginText" Grid.Column="4" FontSize="12" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ElapsedText" Grid.Column="5" FontSize="12" VerticalAlignment="Center" Text="00:00:00" />
            <TextBlock x:Name="RowsText" Grid.Column="6" FontSize="12" VerticalAlignment="Center" Text="0 rows" />
        </Grid>
    </Grid>
</UserControl>
