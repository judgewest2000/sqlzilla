<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sqlzilla.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sqlzilla.Views">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="ExplorerItemTemplate" x:DataType="views:ExplorerEntry">
                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                              HasUnrealizedChildren="False" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="14" Height="14" CornerRadius="4" Background="{x:Bind GroupBrush}" VerticalAlignment="Center"
                                Visibility="{x:Bind SwatchVisibility}" />
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphBrush}" Visibility="{x:Bind GlyphVisibility}" />
                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="{x:Bind LabelWeight}" Opacity="{x:Bind LabelOpacity}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Visibility="{x:Bind ReadOnlyVisibility}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Read-only group" />
                    </StackPanel>
                </TreeViewItem>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewQueryAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="NewQueryAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="F" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="ExecuteAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="Sqlzilla" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="TitleGroupBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TitleGroupText" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock x:Name="TitleContext" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- Server explorer -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,1,0" CornerRadius="0,8,0,0" RowSpacing="4" Padding="4,8,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="8,0,0,0">
                    <TextBlock Text="Servers" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Click="NewQuery_Click" ToolTipService.ToolTip="New query on the selected server (Ctrl+N)">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="NewServer_Click" ToolTipService.ToolTip="Add server">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="NewGroup_Click" ToolTipService.ToolTip="New group">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="RefreshAll_Click" ToolTipService.ToolTip="Refresh database lists">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="ExplorerSearch" Grid.Row="1" Margin="4,0" PlaceholderText="Search servers and databases"
                         TextChanged="ExplorerSearch_TextChanged" KeyDown="ExplorerSearch_KeyDown"
                         ToolTipService.ToolTip="Filters by group, server or database name (Ctrl+Shift+F). Enter opens the first match, Esc clears." />
                <TreeView x:Name="ServerTree" Grid.Row="2" ItemsSource="{x:Bind RootEntries}" SelectionMode="Single" ItemTemplate="{StaticResource ExplorerItemTemplate}"
                          ItemInvoked="ServerTree_ItemInvoked" Expanding="ServerTree_Expanding" DoubleTapped="ServerTree_DoubleTapped"
                          RightTapped="ServerTree_RightTapped" CanDragItems="False" AllowDrop="False" />
                <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="3" Padding="8,8,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Double-click a database to open a query" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Click="About_Click" ToolTipService.ToolTip="About Sqlzilla">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
            <!-- Hangs mostly outside the explorer so it doesn't cover the tree's scrollbar -->
            <views:PaneSplitter Target="0" ShowLine="False" HorizontalAlignment="Right" Margin="0,0,-8,0" Canvas.ZIndex="1"
                                ToolTipService.ToolTip="Drag to resize · double-click to reset" />

            <!-- Query windows -->
            <StackPanel x:Name="Welcome" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <Image x:Name="WelcomeArt" Width="128" Height="128" Opacity="0.9" />
                <TextBlock Text="No query windows open" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Double-click a database (or a server pinned to a database) in the explorer, or select one and press Ctrl+N. Query windows take on the colour of their server's group." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Add server" Style="{StaticResource AccentButtonStyle}" Click="NewServer_Click" />
                    <Button Content="New group" Click="NewGroup_Click" />
                </StackPanel>
            </StackPanel>
            <TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Stretch" AddTabButtonClick="Tabs_AddTabButtonClick" TabCloseRequested="Tabs_TabCloseRequested"
                     SelectionChanged="Tabs_SelectionChanged" TabWidthMode="SizeToContent" CanReorderTabs="True" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
