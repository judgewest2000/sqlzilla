<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Sqlzilla.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:WinUIEditor"
    xmlns:views="using:Sqlzilla.Views"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="CodeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <!-- Replaces WinUIEdit's completion popup template: compact Monaco-style rows in the code font.
                 The popup reserves 32 dip per row, so the list is top-aligned and capped at 12 compact rows. -->
            <Style TargetType="editor:AutocompletionControl">
                <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="editor:AutocompletionControl">
                            <Border
                                VerticalAlignment="Top"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <Border.Resources>
                                    <x:Double x:Key="ListViewItemMinHeight">22</x:Double>
                                </Border.Resources>
                                <ListView
                                    x:Name="Suggestions"
                                    MaxHeight="270"
                                    Padding="0,2"
                                    ItemContainerTransitions="{x:Null}"
                                    ItemsSource="{TemplateBinding ItemsSource}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="MinHeight" Value="22" />
                                            <Setter Property="Height" Value="22" />
                                            <Setter Property="Padding" Value="6,0,10,0" />
                                            <Setter Property="Margin" Value="2,0" />
                                            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <views:CompletionRow Text="{Binding}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Replaces WinUIEdit's editor template so the scroll bars sit outside the text (like the results grid)
                 instead of over it. Scintilla sizes its surface from ImageTarget, so it must stay in the first cell only. -->
            <Style TargetType="editor:EditorBaseControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="editor:EditorBaseControl">
                            <Grid
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ImageTarget" AllowDrop="True" />
                                <ScrollBar
                                    x:Name="VerticalScrollBar"
                                    Grid.Column="1"
                                    Margin="2,0,0,0"
                                    IndicatorMode="MouseIndicator"
                                    IsTabStop="False"
                                    Orientation="Vertical" />
                                <ScrollBar
                                    x:Name="HorizontalScrollBar"
                                    Grid.Row="1"
                                    Margin="0,2,0,0"
                                    IndicatorMode="MouseIndicator"
                                    IsTabStop="False"
                                    Orientation="Horizontal" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
